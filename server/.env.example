PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (required in production; in-memory fallback requires explicit local/test opt-in)
MONGODB_URI=mongodb://127.0.0.1:27017/devflow
USE_IN_MEMORY_DB=false

# Auth
# Use a unique randomly generated value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Demo Account Configuration (Optional - Defaults provided)
DEMO_USER_EMAIL=demo@devflow.ai
DEMO_USER_PASSWORD=password123
ENABLE_DEMO_SEED=false

# AI Configuration (Optional: Gemini, OpenAI, Groq, Anthropic)
# If left blank, DevFlow uses high-fidelity heuristic simulation
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=

# GitHub Integration (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
GITHUB_TOKEN=
# Required for the public webhook endpoint.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
